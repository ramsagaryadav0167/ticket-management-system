# Copy to .env and fill in. Used by docker compose and can be exported for `java -jar`.
DB_URL=jdbc:mysql://db:3306/ticket_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=ticket_app
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=choose-a-strong-password
APP_ADMIN_EMAIL=admin@yourcompany.com

# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
